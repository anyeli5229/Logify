generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TaskStatus {
  PENDING
  ON_HOLD
  IN_PROGRESS
  UNDER_REVIEW
  COMPLETED
}

model Project {
  id          String   @id @default(uuid())
  projectName String   @map("project_name")
  clientName  String   @map("client_name")
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tasks Task[]

  // Relación Propietario / Creador
  userId  String @map("user_id")
  manager User   @relation("Manager", fields: [userId], references: [id], onDelete: Cascade)

  // Relación Equipo / Colaboradores
  team User[] @relation("ProjectTeam")

  @@map("projects")
}

model User {
  id        String   @id @default(uuid())
  name      String
  email     String   @unique
  password  String
  confirmed Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  tokens Token[]

  //  Proyectos creados por este usuario
  projects Project[] @relation("Manager")

  // Proyectos donde este usuario es parte del equipo
  memberOfProjects Project[] @relation("ProjectTeam")

  // Tareas completadas por este usuario
  // Relación con el historial de tareas
  taskHistories TaskHistory[]

  @@map("users")
}

model Task {
  id          String     @id @default(uuid())
  name        String
  description String
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  projectId String  @map("project_id")
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // Relación para obtener todo el historial de cambios
  history TaskHistory[]

  @@map("tasks")
}

model TaskHistory {
  id        String     @id @default(uuid())
  status    TaskStatus
  updatedAt DateTime   @default(now()) @map("updated_at")

  taskId String @map("task_id")
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("task_history")
}

model Token {
  id        String   @id @default(uuid())
  token     String
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")
  expiresAt DateTime @map("expires_at")

  @@map("tokens")
}
